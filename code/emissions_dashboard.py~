# === Import required libraries ===
import dash  # Core Dash package for app framework
from dash import dcc, html, Input, Output  # Dash components for UI and interactivity
import dash_bootstrap_components as dbc  # Optional Bootstrap component library for styling/layout
import pandas as pd  # Data analysis library
import plotly.express as px  # Plotting library (used for charts)
from pathlib import Path  # Cross-platform path handling

# === Load the emissions dataset ===
# Define the path to the project root and CSV file using pathlib for reliability
project_root = Path(__file__).resolve().parent.parent
data_path = project_root / "output" / "flights_2025-05-01.csv"
df = pd.read_csv(data_path)  # Load CSV data into a pandas DataFrame

# === Initialize Dash app with Bootstrap theme ===
app = dash.Dash(__name__, external_stylesheets=[dbc.themes.FLATLY])
app.title = "Emissions Compliance Dashboard"  # Browser tab title

# === Define layout using Bootstrap's grid system ===
app.layout = dbc.Container([  # Container ensures content is nicely padded and responsive

    # Title of the dashboard
    html.H1("Emissions Compliance Dashboard", className="my-4 text-center"),

    # Dropdown selector row (top control panel)
    dbc.Row([
        dbc.Col([
            html.Label("Select Operator:", className="fw-bold"),  # Label in bold
            dcc.Dropdown(
                options=[{"label": op, "value": op} for op in ["All"] + sorted(df['operator_name'].unique())],
                value="All",  # Default selection
                id="operator-dropdown"  # Trigger component for callback
            )
        ], width=4)  # Only one-third width of the row
    ], className="mb-4"),

    # KPI cards row — shows summary values in styled boxes
    dbc.Row([
        dbc.Col(dbc.Card([
            dbc.CardBody([
                html.H5("Total Flights", className="card-title"),
                html.H2(id="kpi-flights", className="card-text")  # Output target
            ])
        ])),
        dbc.Col(dbc.Card([
            dbc.CardBody([
                html.H5("EEA Coverage", className="card-title"),
                html.H2(id="kpi-eea", className="card-text")
            ])
        ])),
        dbc.Col(dbc.Card([
            dbc.CardBody([
                html.H5("Verified Reports", className="card-title"),
                html.H2(id="kpi-verified", className="card-text")
            ])
        ])),
        dbc.Col(dbc.Card([
            dbc.CardBody([
                html.H5("Total CO₂ (t)", className="card-title"),
                html.H2(id="kpi-emissions", className="card-text")
            ])
        ]))
    ], className="mb-4"),  # Add spacing below row

    # Row with two interactive graphs: emissions by aircraft, and compliance status
    dbc.Row([
        dbc.Col(dcc.Graph(id="emissions-by-aircraft"), width=6),
        dbc.Col(dcc.Graph(id="compliance-pie"), width=6)
    ])
], fluid=True)  # `fluid=True` makes it stretch full width on the screen

# === Register callback to update KPIs and plots based on dropdown selection ===
print("Registering callback...")  # Debug message to confirm only one registration

@app.callback(
    Output("kpi-flights", "children"),
    Output("kpi-eea", "children"),
    Output("kpi-verified", "children"),
    Output("kpi-emissions", "children"),
    Output("emissions-by-aircraft", "figure"),
    Output("compliance-pie", "figure"),
    Input("operator-dropdown", "value")  # React to change in dropdown
)
def update_dashboard(selected_operator):
    """
    Dynamically updates KPIs and plots based on the selected airline operator.
    """
    try:
        # Filter the dataframe based on selected operator
        df_filtered = df if selected_operator == "All" else df[df["operator_name"] == selected_operator]

        # === KPI calculations ===
        kpi_flights = len(df_filtered)
        kpi_eea = f"{df_filtered['in_eea'].mean() * 100:.1f}%"  # % of flights within EEA
        kpi_verified = f"{df_filtered['verified'].mean() * 100:.1f}%"  # % of verified reports
        kpi_emissions = f"{df_filtered['co2_emissions_kg'].sum() / 1000:.1f}"  # Convert to tonnes

        # === Create bar chart: total emissions grouped by aircraft type ===
        fig1 = px.bar(
            df_filtered.groupby("aircraft_type")["co2_emissions_kg"].sum().reset_index(),
            x="aircraft_type", y="co2_emissions_kg",
            title="CO₂ Emissions by Aircraft Type",
            labels={"co2_emissions_kg": "CO₂ (kg)"}
        )

        # === Create pie chart: distribution of compliant vs non-compliant flights ===
        if df_filtered['operator_compliant'].nunique() > 1:
            fig2 = px.pie(
                df_filtered,
                names="operator_compliant",
                title="Compliance Status Distribution",
                hole=0.4,  # Donut chart
                labels={True: "Compliant", False: "Non-Compliant"}
            )
        else:
            # Fallback if there's only one category (avoids crash)
            fig2 = px.pie(
                names=["Only one class"],
                values=[1],
                title="Compliance Status Distribution",
                hole=0.4
            )

        # Return values for all outputs
        return kpi_flights, kpi_eea, kpi_verified, kpi_emissions, fig1, fig2

